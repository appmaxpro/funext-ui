{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": "./",
    "paths": {
      "@/mui/*": ["src/mui/*"],
      "@/mui/*": ["src/mui/*"],
      "@/core/*": ["src/core/*"],
      "@/icons/*": ["src/icons/*"],
      "@/grid/*": ["src/grid/*"],
      "@/kanban/*": ["src/kanban/*"],
      "@/gantt/*": ["src/gantt/*"],
      "@/store/*": ["src/store/*"],
      "./*": ["src/*"],
    },
  },
  "include": ["src"],
  "exclude": [
    "**/*.js",
    "**/*.stories.*",
    "**/dist",
    "**/node_modules",
    "dist/",
    "stories/"
  ],

  "references": [{ "path": "./tsconfig.node.json" }]

}
