{
  "name": "funext-ui",
  "version": "0.9.1",
  "license": "MIT",
  "description": "Components and APIs for building dashboards and internal tools",
  "repository": "https://github.com/mui/toolpad.git",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "proptypes": "tsx ./scripts/generateProptypes.ts",
    "prettier:all": "prettier --write . --ignore-path .eslintignore",
    "ui:dev": "pnpm --filter ./packages/ui storybook",
    "ui:build": "pnpm --filter ./packages/ui build",
    "owl:rect": "pnpm --filter ./packages/owl-react dev",
    "owner:dev": "pnpm --filter ./packages/owner dev",
    "next:demo": "pnpm --filter ./demos/next-app-demo npm:dev",
    "docs:build": "pnpm --filter ./packages/docs build",
    "eslint": "eslint . --report-unused-disable-directives --ext .js,.ts,.tsx",
    "jsonlint": "node ./scripts/jsonlint.mjs",
    "test": "lerna run test --stream",
    "check-types": "lerna run --concurrency 1 check-types",
    "clean": "pnpm -r exec rm -rf build dist"
  },
  "devDependencies": {
    "@argos-ci/core": "2.11.0",
    "@babel/cli": "7.25.9",
    "@babel/core": "7.26.0",
    "@babel/node": "7.26.0",
    "@babel/plugin-transform-react-constant-elements": "7.25.9",
    "@babel/plugin-transform-runtime": "7.25.9",
    "@babel/preset-env": "7.26.0",
    "@babel/preset-react": "7.25.9",
    "@babel/preset-typescript": "7.26.0",
    "@next/eslint-plugin-next": "14.2.23",
    "@playwright/test": "1.47.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/archiver": "6.0.3",
    "@types/fs-extra": "11.0.4",
    "@types/gtag.js": "0.0.20",
    "@types/invariant": "2.2.37",
    "@types/node": "^20.17.16",
    "@types/yargs": "17.0.33",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "2.1.8",
    "babel-plugin-react-remove-properties": "0.3.0",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "chalk": "5.3.0",
    "concurrently": "9.1.0",
