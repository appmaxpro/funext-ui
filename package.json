    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^18.3.1",
    "semver": "7.6.3",
    "stylis-plugin-rtl": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.5",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "vitest": "2.1.9",
    "yargs": "17.7.2",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  },
  "engines": {
    "pnpm": "9.12.3"
  },
  "resolutions": {
    "google-auth-library": "*",
    "@types/node": "^20.17.16",
    "@types/react": "18.2.73",
    "@types/react-dom": "18.2.21"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@babel/*",
        "@eslint/*"
      ]
    },
    "ignoredOptionalDependencies": [
      "@mui\\material",
      "@mui\\x-charts"
    ]
  }
}