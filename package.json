{
  "name": "@funext/ui",
  "version": "0.1.8",
  "author": "Funext",
  "license": "AGPL-3.0-only",
  "keywords": [
    "react",
    "components",
    "ui",
    "funext"
  ],
  "//": "type: module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts",
    "./core/*": "./src/core/*/index.ts",
    "./icons/*": "./src/icons/*/index.ts",
    "./mui/themes/tw/withMT": "./src/mui/themes/tw/withMT.js"
  },
  "scripts": {
    "preinstall": "node scripts/check-pnpm.js",
    "format": "prettier -w '**/*.{ts,tsx,js,jsx,json,css,scss}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "node  --experimental-modules scripts/build.js . -o dist",
    "clean": "rimraf dist & rimraf node_modules/.cache/vite",
    "lint": "eslint src",
    "build:react": "pnpm --filter ./packages/material-tailwind-react build",
    "tw": "npx tailwindcss -i ./src/global.css -o ./dist/global.css",
    "build-tailwind": "NODE_ENV=production npx tailwindcss -i ./src/global.css -o ./dist/global.css --postcss --minify"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/is-prop-valid": "^1.2.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@floating-ui/react": "^0.26.20",
    "@fluentui/priority-overflow": "^9.1.11",
    "@fluentui/react-context-selector": "^9.1.56",
    "@fontsource/roboto": "^5.0.13",
    "@material-symbols/font-400": "^0.17.1",
    "@material-symbols/metadata": "^0.17.1",
    "@mui/system": "6.1.6",
    "@mui/utils": "6.1.6",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "classnames": "2.3.2",
    "color": "^4.2.3",
    "csstype": "^3.1.3",
    "dayjs": "^1.11.10",
    "deepmerge": "4.2.2",
    "focus-trap": "^7.5.4",
    "framer-motion": "^11.3.21",
    "immer": "^10.0.4",
    "prop-types": "15.8.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-is": "^18.3.1",
    "react-material-symbols": "^4.4.0",
    "react-transition-group": "^4.4.5",
    "stylis": "^4.3.2",
    "stylis-plugin-rtl": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.0.5",
    "@storybook/addon-interactions": "^8.0.5",
    "@storybook/addon-links": "^8.0.5",
    "@storybook/addon-themes": "^8.0.5",
    "@storybook/blocks": "^8.0.5",
    "@storybook/react": "^8.0.5",
    "@storybook/react-vite": "^8.0.5",
    "@storybook/testing-library": "^0.2.2",
    "@types/color": "^3.0.6",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.23",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "commander": "^12.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "i18next": "^23.10.1",
    "postcss": "^8.4.41",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "rimraf": "^5.0.5",
    "sass": "^1.72.0",
    "storybook": "^8.0.5",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.4.3",
    "vite": "^5.4.0",
    "vite-plugin-handlebars": "^2.0.0",
    "vite-plugin-svgr": "^4.2.0"
  },
  "packageManager": "pnpm@8.15.5+sha256.4b4efa12490e5055d59b9b9fc9438b7d581a6b7af3b5675eb5c5f447cee1a589",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@babel/*",
        "@eslint/*"
      ]
    }
  },
  "resolutions": {
    "@types/react": "18.2.73",
    "@types/react-dom": "18.2.21"
  }
}
