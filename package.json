{
  "name": "funext-ui",
  "version": "0.9.1",
  "license": "MIT",
  "description": "Components and APIs for building dashboards and internal tools",
  "repository": "https://github.com/mui/toolpad.git",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "proptypes": "tsx ./scripts/generateProptypes.ts",
    "prettier:all": "prettier --write . --ignore-path .eslintignore",
    "ui:dev": "pnpm --filter ./packages/ui storybook",
    "ui:build": "pnpm --filter ./packages/ui build",
    "owl:rect": "pnpm --filter ./packages/owl-react dev",
    "owner:dev": "pnpm --filter ./packages/owner dev",
    "owner:debug": "pnpm --filter ./packages/owner debug",
    "next:demo": "pnpm --filter ./demos/next-app-demo npm:dev",
    "docs:build": "pnpm --filter ./packages/docs build",
    "eslint": "eslint . --report-unused-disable-directives --ext .js,.ts,.tsx",
    "jsonlint": "node ./scripts/jsonlint.mjs",
    "test": "lerna run test --stream",
    "check-types": "lerna run --concurrency 1 check-types",
    "clean": "rimraf build && rimraf node_modules/.vite && rimraf node_modules/.vite-temp",
    "clean_all": "rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.13",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "terser": "^5.46.0",
    "jsdom": "^28.0.0"
  },
  "resolutions": {
    "google-auth-library": "*",
    "@types/node": ">20.17.16"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@babel/*",
        "@eslint/*"
      ]
    },
    "ignoredBuiltDependencies": [
      "@mui/material",
      "@mui/x-charts",
      "react-redux",
      "@tree-sitter-grammars/tree-sitter-yaml",
      "@scarf/scarf",
      "core-js",
      "core-js-pure",
      "tree-sitter",
      "tree-sitter-json"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}