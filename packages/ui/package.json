{
  "name": "@funext/ui",
  "version": "0.1.8",
  "author": "Funext",
  "license": "AGPL-3.0-only",
  "keywords": [
    "react",
    "components",
    "ui",
    "funext"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#is-development": {
      "development": "./src/utils/conditions/true.ts",
      "default": "./src/utils/conditions/false.ts"
    },
    "#is-browser": {
      "browser": "./src/utils/conditions/true.ts",
      "default": "./src/utils/conditions/is-browser.ts"
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-pnpm.js",
    "format": "prettier -w '**/*.{ts,tsx,js,jsx,json,css,scss}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "node  --experimental-modules scripts/build.js . -o dist",
    "clean": "rimraf dist & rimraf node_modules/.cache/vite & rimraf storybook-static",
    "lint": "eslint src",
    "build:react": "pnpm --filter ./packages/material-tailwind-react build",
    "tw": "npx tailwindcss -i ./src/global.css -o ./dist/global.css",
    "build-tailwind": "NODE_ENV=production npx tailwindcss -i ./src/global.css -o ./dist/global.css --postcss --minify"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@emotion/is-prop-valid": "^1.2.2",
    "@emotion/sheet": "^1.4.0",
    "@floating-ui/react": "^0.27.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@mui/system": "6.1.6",
    "@mui/utils": "6.1.6",
    "stylis": "^4.2.0",
    "stylis-plugin-rtl": "^2.1.1",
    "@af-utils/virtual-core": "^1.0.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.5"
  },
  "dependencies": {
    "classnames": "2.3.2",
    "color": "^4.2.3",
    "deepmerge": "4.2.2",
    "focus-trap": "^7.5.4",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@emotion/babel-preset-css-prop": "^11.12.0",
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@types/node": "^24.12.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^5.1.4",
    "commander": "^14.0.3",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "globals": "^17.4.0",
    "i18next": "^25.10.10",
    "prettier": "^3.8.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.6",
    "rimraf": "^6.1.3",
    "sass": "1.77.8",
    "semver": "^7.7.4",
    "storybook": "^10.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "~7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "@tailwindcss/vite": "^4.1.5",
    "tailwindcss": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "@emotion/cache": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "@emotion/react": {
      "optional": true
    },
    "@emotion/sheet": {
      "optional": true
    },
    "@af-utils/virtual-core": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "stylis": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts",
    "./components/*": "./src/components/*",
    "./components/**/": "./src/components/**/",
    "./components/SvgIcon": "./src/components/SvgIcon/index.ts",
    "./Accordion": "./src/components/Accordion/index.ts",
    "./Alert": "./src/components/Alert/index.ts",
    "./Avatar": "./src/components/Avatar/index.ts",
    "./Button": "./src/components/Button/index.ts",
    "./BottomNavigation": "./src/components/BottomNavigation/index.ts",
    "./Card": "./src/components/Card/index.ts",
    "./Checkbox": "./src/components/Checkbox/index.ts",
    "./Chip": "./src/components/Chip/index.ts",
    "./Popper": "./src/components/Popper/index.ts",
    "./Dialog": "./src/components/Dialog/index.ts",
    "./IconButton": "./src/components/IconButton/index.ts",
    "./Input": "./src/components/Input/index.ts",
    "./Menu": "./src/components/Menu/index.ts",
    "./Popover": "./src/components/Popover/index.ts",
    "./Progress": "./src/components/Progress/index.ts",
    "./Radio": "./src/components/Radio/index.ts",
    "./Select": "./src/components/Select/index.ts",
    "./Switch": "./src/components/Switch/index.ts",
    "./Tooltip": "./src/components/Tooltip/index.ts",
    "./Text": "./src/components/Text/index.ts",
    "./Collapse": "./src/components/Collapse/index.ts",
    "./List": "./src/components/List/index.ts",
    "./ButtonGroup": "./src/components/ButtonGroup/index.ts",
    "./Drawer": "./src/components/Drawer/index.ts",
    "./Badge": "./src/components/Badge/index.ts",
    "./Slider": "./src/components/Slider/index.ts",
    "./Spinner": "./src/components/Spinner/index.ts",
    "./Timeline": "./src/components/Timeline/index.ts",
    "./Stepper": "./src/components/Stepper/index.ts",
    "./SpeedDial": "./src/components/SpeedDial/index.ts",
    "./Panel": "./src/components/Panel/index.ts",
    "./Divider": "./src/components/Divider/index.ts",
    "./Link": "./src/components/Link/index.ts",
    "./Box": "./src/components/Box/index.ts",
    "./Stack": "./src/components/Stack/index.ts",
    "./Grid": "./src/components/Grid/index.ts",
    "./AutoSelect": "./src/components/Select/AutoSelect/index.ts",
    "./Focus": "./src/components/Focus/index.ts",
    "./Snackbar": "./src/components/Snackbar/index.ts",
    "./GlobalStyles": "./src/components/GlobalStyles/index.ts",
    "./Screen": "./src/components/Screen/index.ts",
    "./Context": "./src/components/Context.tsx",
    "./SvgIcon": "./src/components/SvgIcon/index.ts",
    "./useAutocomplete": "./src/components/useAutocomplete/index.ts",
    "./Chevron": "./src/components/internal/svg-icons/chevron.tsx",
    "./CloseIcon": "./src/components/internal/svg-icons/Close.tsx",
    "./SearchIcon": "./src/components/internal/svg-icons/Search.tsx",
    "./Grow": "./src/lib/transitions/grow/index.ts",
    "./Slide": "./src/lib/transitions/slide/index.ts",
    "./Fade": "./src/lib/transitions/fade/index.ts",
    "./CoreThemeProvider": "./src/mui/CoreThemeProvider",
    "./svg-icon": "./src/svg-icon.ts",
    "./global.css": "./src/global.css",
    "./base.css": "./src/base.css",
    "./package.json": "./package.json"
  }
}
