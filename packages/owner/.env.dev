# Target host to proxy to
VITE_PROXY_TARGET=http://funext.io:8800
#NEXT_PROXY_TARGET=http://localhost:8080
FUNEXT_API_SERVER=${NEXT_PROXY_TARGET}
NEXT_PROTOCOL=http
NEXT_PORT=3000
NEXT_HOST=localhost
NEXT_PUBLIC_BASE_URL=${NEXT_PROTOCOL}://${NEXT_HOST}:${NEXT_PORT}
NEXT_PROXY_CONTEXT=/
NODE_OPTIONS=4096

SW=true