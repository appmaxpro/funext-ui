  "scripts": {
    "dev": "vite --config vite-dev.config.ts",
    "debug": "vite --debug hmr --config vite-dev.config.ts",
    "clean": "rimraf build && rimraf node_modules/.vite && rimraf node_modules/.vite-temp",
    "clean_all": "rimraf node_modules",
    "build": "rimraf build && vite build --config vite.config.build.ts",
    "build:dev": "rimraf build && vite build --mode development --config vite.config.build.ts",
    "tsc": "rimraf build && tsc",
    "build:staging": "rimraf build && vite build --config vite-staging.config.ts",
    "preview": "vite preview --outDir build",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,scss,html}\"",
    "test": "vitest",
    "lint": "eslint src",
    "flags": "scripts/flags/generate_combined_flags_and_css.sh",
    "svgo": "svgo --multipass src/assets/*.svg",
    "generate-pwa": "pwa-assets-generator --preset minimal public/logo.svg"
  },
