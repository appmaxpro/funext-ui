{
  "name": "@funext/ux",
  "version": "0.1.8",
  "author": "Funext",
  "license": "AGPL-3.0-only",
  "keywords": [
    "react",
    "components",
    "ui",
    "funext"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts",
    "./core/*": "./src/core/*/index.ts",
    "./icons/*": "./src/icons/*/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier -w '**/*.{ts,tsx,js,jsx,json,css,scss}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "node  --experimental-modules scripts/build.js . -o dist",
    "clean": "rimraf dist & rimraf node_modules/.cache/vite",
    "lint": "eslint src",
    "build:react": "pnpm --filter ./packages/material-tailwind-react build",
    "tw": "npx tailwindcss -i ./src/global.css -o ./dist/global.css",
    "build-tailwind": "NODE_ENV=production npx tailwindcss -i ./src/global.css -o ./dist/global.css --postcss --minify"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/is-prop-valid": "^1.2.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@funext/ui": "workspace:*"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "color": "^4.2.3",
    "dayjs": "^1.11.10",
    "deepmerge": "4.2.2",
    "immer": "^10.0.4",
    "react-beautiful-dnd": "^13.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-is": "^18.3.1"
  },
  "devDependencies": {
    "@emotion/babel-preset-css-prop": "^11.12.0",
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@types/node": "^24.12.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^5.1.4",
    "commander": "^14.0.3",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "globals": "^17.4.0",
    "i18next": "^25.10.10",
    "prettier": "^3.8.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.6",
    "rimraf": "^6.1.3",
    "sass": "1.77.8",
    "semver": "^7.7.4",
    "storybook": "^10.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "~7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "@tailwindcss/vite": "^4.1.5",
    "tailwindcss": "^4.1.5"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  }
}
