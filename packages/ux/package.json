{
  "name": "@funext/ux",
  "version": "0.1.8",
  "author": "Funext",
  "license": "AGPL-3.0-only",
  "keywords": [
    "react",
    "components",
    "ui",
    "funext"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts",
    "./core/*": "./src/core/*/index.ts",
    "./icons/*": "./src/icons/*/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier -w '**/*.{ts,tsx,js,jsx,json,css,scss}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "node  --experimental-modules scripts/build.js . -o dist",
    "clean": "rimraf dist & rimraf node_modules/.cache/vite",
    "lint": "eslint src",
    "build:react": "pnpm --filter ./packages/material-tailwind-react build",
    "tw": "npx tailwindcss -i ./src/global.css -o ./dist/global.css",
    "build-tailwind": "NODE_ENV=production npx tailwindcss -i ./src/global.css -o ./dist/global.css --postcss --minify"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/is-prop-valid": "^1.2.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@funext/ui": "workspace:*"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "color": "^4.2.3",
    "dayjs": "^1.11.10",
    "deepmerge": "4.2.2",
    "immer": "^10.0.4",
    "react-beautiful-dnd": "^13.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-is": "^18.3.1"
  },
  "devDependencies": {
    "@emotion/babel-preset-css-prop": "^11.12.0",
    "@storybook/addon-essentials": "^8.0.5",
    "@storybook/addon-interactions": "^8.0.5",
    "@storybook/addon-links": "^8.0.5",
    "@storybook/addon-themes": "^8.0.5",
    "@storybook/blocks": "^8.0.5",
    "@storybook/react": "^8.0.5",
    "@storybook/react-vite": "^8.0.5",
    "@storybook/testing-library": "^0.2.2",
    "@types/color": "^3.0.6",
    "@types/node": "^20.11.30",
    "@types/react": "^19.1.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.1.0",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "babel-plugin-macros": "^3.1.0",
    "commander": "^12.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "i18next": "^23.10.1",
    "postcss": "^8.4.41",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^14.1.0",
    "rimraf": "^5.0.5",
    "sass": "^1.72.0",
    "storybook": "^8.0.5",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.4.3",
    "csstype": "^3.1.3",
    "vite": "^5.4.0",
    "vite-plugin-handlebars": "^2.0.0",
    "vite-plugin-svgr": "^4.2.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  }
}
